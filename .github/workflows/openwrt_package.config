CONFIG_PACKAGE_luci-app-qmodem-next=m
CONFIG_PACKAGE_luci-i18n-qmodem-next-zh-cn=m
# The SDK's default x86 profile selects this legacy kernel package, whose
# out-of-tree build is unavailable in the release SDK. QModem does not use it.
CONFIG_PACKAGE_gpio-button-hotplug=n
CONFIG_PACKAGE_qmodem-smsd=m
CONFIG_PACKAGE_sms-forwarder-next=m
CONFIG_PACKAGE_tom_modem=m
CONFIG_PACKAGE_tom_modem_EARLY_RETURN=y
CONFIG_PACKAGE_tom_modem_ENABLE_UBUS_DAEMON=y
CONFIG_PACKAGE_quectel-CM-5G-M=m
CONFIG_PACKAGE_qmodem=m
CONFIG_PACKAGE_qmodem_INCLUDE_generic-qmi-wwan=y
CONFIG_PACKAGE_ubus-at-daemon=m

CONFIG_PACKAGE_qmodem-uplink-manager=m
CONFIG_PACKAGE_luci-app-qmodem-uplink=m
