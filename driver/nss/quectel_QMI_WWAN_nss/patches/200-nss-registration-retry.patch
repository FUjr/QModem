+/* QMI_WWAN_Q_NSS_RETRY: NSS firmware, USB probe'undan sonra boot ediyor.
+ * Ilk nss_create() -1 donuyor; arka planda tekrar deniyoruz. */
+#define QMAP_NSS_RETRY_MAX 90
+#define QMAP_NSS_RETRY_DELAY_MS 1000
+
+static void qmap_nss_retry_work(struct work_struct *work)
+{
+	struct qmap_priv *priv = container_of(to_delayed_work(work),
+					struct qmap_priv, nss_retry_work);
+	struct net_device *qmap_net = priv->self_dev;
+	int rc;
+
+	if (!nss_cb || priv->use_qca_nss || !qmap_net)
+		return;
+
+	rc = nss_cb->nss_create(qmap_net);
+	if (rc) {
+		priv->nss_retry_count++;
+		if (priv->nss_retry_count < QMAP_NSS_RETRY_MAX) {
+			schedule_delayed_work(&priv->nss_retry_work,
+					msecs_to_jiffies(QMAP_NSS_RETRY_DELAY_MS));
+		} else {
+			netdev_err(qmap_net, "NSS registration gave up after %u attempts: %d\n",
+					priv->nss_retry_count, rc);
+		}
+		return;
+	}
+
+	priv->use_qca_nss = 1;
+	netdev_info(qmap_net, "NSS context created (after %u retries)\n",
+			priv->nss_retry_count);
+	rtnl_lock();
+	netdev_rx_handler_register(qmap_net, qca_nss_rx_handler, NULL);
+	rtnl_unlock();
+}
+
