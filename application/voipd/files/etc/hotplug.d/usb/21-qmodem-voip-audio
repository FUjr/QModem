#!/bin/sh
# Re-converge only the journal owned by the USB modem that re-enumerated.
[ -n "${DEVPATH:-}" ] || exit 0
[ "${ACTION:-}" = bind ] || [ "${ACTION:-}" = add ] || exit 0
recover_group()
{
 local group="$1" modem journal slot
 case "$group" in ''|*[!A-Za-z0-9_]*) return ;; esac
 modem=$(uci -q get "qmodem_voip.$group.modem_id") || return
 case "$modem" in ''|*[!A-Za-z0-9_]*) return ;; esac
 journal="/var/lib/qmodem_voip/$group/modem-safety.journal"
 [ -r "$journal" ] && grep -q '^phase=enabled$' "$journal" || return
 slot=$(sed -n 's/^slot=//p' "$journal")
 case "$slot" in ''|*[!A-Za-z0-9._-]*) return ;; esac
 case "$DEVPATH" in */"$slot"|*/"$slot/"*|*/"$slot:"*) ;; *) return ;; esac
 logger -t qmodem_voip "usb_event ${ACTION} group $group"
 # The safety helper validates the journal checksum and selected physical ports.
 ( export QMODEM_VOIP_MODEM_ID="$modem" QMODEM_VOIP_JOURNAL="$journal"
   /usr/sbin/qmodem_voip_modem_safety recover >/dev/null 2>&1 ) &
}
for group in $(uci -q show qmodem_voip | sed -n 's/^qmodem_voip\.\([A-Za-z0-9_]*\)=modem$/\1/p'); do
 recover_group "$group"
done
exit 0
