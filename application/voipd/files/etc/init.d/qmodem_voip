#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1

start_service()
{
	mkdir -p -m 700 /etc/qmodem_voip
	mkdir -p -m 700 /var/run/qmodem_voip
	mkdir -p -m 700 /var/lib/qmodem_voip
	interface=$(uci -q get qmodem_voip.main.interface)
	interface=${interface:-lan}
	case $interface in ''|*[!A-Za-z0-9_.:-]*) return 1 ;; esac
	media_socket_path=$(uci -q get qmodem_voip.main.media_socket_path)
	media_socket_path=${media_socket_path:-/var/run/qmodem_voip/media.sock}
	enabled=$(uci -q get qmodem_voip.main.enabled)
	case $enabled in 1) ;; *) enabled=0 ;; esac
	procd_open_instance
	procd_set_param command /usr/sbin/qmodem_voip_daemon_wait \
		--media-interface "$interface" \
		--media-cert /dev/null \
		--media-key /dev/null \
		--media-socket-path "$media_socket_path" \
		--start-enabled "$enabled"
	procd_set_param respawn 3600 5 5
	procd_close_instance
	/usr/sbin/qmodem_voip_web
}

reload_service()
{
	# An RM520 policy change may re-enumerate USB. Keep the live call intact.
	status=$(ubus -t 2 call qmodem_voip status 2>/dev/null)
	policy=$(printf '%s' "$status" | jsonfilter -e '@.audio_policy')
	state=$(printf '%s' "$status" | jsonfilter -e '@.state')
	case $policy:$state in
	?*:active|?*:incoming_ringing|?*:outgoing_setup|?*:early_media|?*:terminating|?*:recovering)
		(
			exec 8>/var/run/qmodem_voip/reload.lock
			flock -n 8 || exit 0
			while :; do
				state=$(ubus -t 2 call qmodem_voip status 2>/dev/null | jsonfilter -e '@.state')
				case $state in idle|disabled|fault) break ;; esac
				sleep 1
			done
			/etc/init.d/qmodem_voip restart
		) </dev/null >/dev/null 2>&1 &
		logger -t qmodem_voip 'audio policy apply deferred until call is idle'
		return 0 ;;
	esac
	stop
	start
	/usr/sbin/qmodem_voip_web
}

service_triggers()
{
	procd_add_reload_trigger qmodem_voip
}
