#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

interface_address()
{
	local interface="$1" status device
	status=$(ubus -t 2 call "network.interface.$interface" status 2>/dev/null) || status=
	device=$(printf '%s\n' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null)
	device=${device:-$interface}
	ip -4 -o addr show dev "$device" scope global 2>/dev/null |
		awk 'NR == 1 { sub(/\/.*/, "", $4); print $4 }'
}

write_outbound_config()
{
	local path=/var/run/qmodem_voip/sip-outbound.conf
	local server port username password realm interval
	server=$(uci -q get qmodem_sip.outbound.server)
	port=$(uci -q get qmodem_sip.outbound.port)
	username=$(uci -q get qmodem_sip.outbound.username)
	password=$(uci -q get qmodem_sip.outbound.password)
	realm=$(uci -q get qmodem_sip.outbound.realm)
	interval=$(uci -q get qmodem_sip.outbound.register_interval)
	{
		printf 'server=%s\n' "$server"
		printf 'server_uri=sips:%s:%s;transport=tls\n' "$server" "$port"
		printf 'aor=sips:%s@%s:%s;transport=tls\n' "$username" "$server" "$port"
		printf 'username=%s\npassword=%s\nrealm=%s\nport=%s\ninterval=%s\n' \
			"$username" "$password" "$realm" "$port" "$interval"
	} >"$path"
	chmod 600 "$path"
	printf '%s\n' "$path"
}

start_direction()
{
	local direction="$1" interface address media_socket modem runner args outbound_config listen_port
	[ "$(uci -q get "qmodem_sip.$direction.enabled")" = 1 ] || return 0
	/usr/sbin/qmodem_voip_sip_validate "$direction" || {
		logger -t qmodem_voip_sipd "$direction configuration rejected"
		return 0
	}
	interface=$(uci -q get "qmodem_sip.$direction.interface")
	address=$(interface_address "$interface")
	[ -n "$address" ] || {
		logger -t qmodem_voip_sipd "$direction interface has no IPv4 address"
		return 0
	}
	media_socket=$(uci -q get qmodem_sip.main.media_socket_path)
	media_socket=${media_socket:-/var/run/qmodem_voip/media.sock}
	modem=$(uci -q get "qmodem_sip.$direction.sms_modem")
	[ "$(uci -q get "qmodem_sip.$direction.sms_enabled")" = 1 ] || modem=
	listen_port=$(uci -q get "qmodem_sip.$direction.listen_port")
	[ -n "$listen_port" ] || {
		[ "$direction" = outbound ] && listen_port=5061 || listen_port=5060
	}
	runner=/usr/bin/qmodem_voip_sip_consumer
	[ "$(uci -q get "qmodem_sip.$direction.voip_enabled")" != 1 ] || \
		runner=/usr/sbin/qmodem_voip_sip_wait
	set -- --listen-address 0.0.0.0 --advertise-address "$address" \
		--media-socket-path "$media_socket" --direction "$direction" \
		--pidfile "/var/run/qmodem_voip/sip-$direction.pid" \
		--sms-modem "$modem" --listen-port "$listen_port"
	if [ "$direction" = outbound ]; then
		outbound_config=$(write_outbound_config) || return 0
		set -- "$@" --mode outbound --outbound-config "$outbound_config"
	fi
	procd_open_instance "$direction"
	procd_set_param command "$runner" "$@"
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

start_service()
{
	mkdir -p -m 700 /var/run/qmodem_voip /etc/qmodem_voip
	procd_open_instance control
	procd_set_param command /usr/sbin/qmodem_voip_sipd
	procd_set_param respawn 3600 5 5
	procd_close_instance
	start_direction inbound
	start_direction outbound
	ubus call service event '{"type":"firewall","data":{"reload":true}}' >/dev/null 2>&1 || :
}

reload_service()
{
	stop
	start
}

service_triggers()
{
	local inbound outbound
	config_load qmodem_sip
	config_get inbound inbound interface
	config_get outbound outbound interface
	[ -z "$inbound" ] || \
		procd_add_interface_trigger "interface.*" "$inbound" \
		/etc/init.d/qmodem_voip_sipd reload
	[ -z "$outbound" ] || [ "$outbound" = "$inbound" ] || \
		procd_add_interface_trigger "interface.*" "$outbound" \
		/etc/init.d/qmodem_voip_sipd reload
	procd_add_reload_trigger qmodem_sip
}
