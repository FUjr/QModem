#!/bin/sh /etc/rc.common
START=99
STOP=12
USE_PROCD=1
start_service() {
    [ "$(uci -q get qmodem_uplink.main.enabled)" = 1 ] || { /usr/libexec/qmodem-uplink-restore; return 0; }
    procd_open_instance
    procd_set_param command /usr/libexec/qmodem-uplink-watch
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 20
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
service_triggers() { procd_add_reload_trigger qmodem_uplink network qmodem firewall; }
reload_service() {
    if [ -s /var/run/qmodem-uplink/pid ]; then
        procd_send_signal qmodem-uplink '*' USR1
    else start; fi
}

service_stopped() { /usr/libexec/qmodem-uplink-restore; }
