sysroot="${QMODEM_SYSFS_ROOT:-/sys}"
manual=$(uci -q get qmodem.main.block_auto_probe)
[ "$manual" = 1 ] && exit 0

logger -t modem_hotplug "net slot: ${DEVPATH} action: ${ACTION}"
hotplug_add_delay=$(uci -q get qmodem.main.hotplug_add_delay || echo 8)
#网络设备名称不存在，退出
[ -z "${INTERFACE}" ] && exit
#网络设备路径不存在，退出
[ -z "${DEVPATH}" ] && exit

# Net devices can be nested below MHI controllers or QMI mux parents.
case "$DEVPATH" in *_IP_SW*) exit 0;; esac
slot_path=$(readlink -f "$sysroot/${DEVPATH}/device")
[ -n "$slot_path" ] || slot_path="$sysroot/${DEVPATH}"
while [ "$slot_path" != / ] && [ "$slot_path" != "$sysroot" ]; do
    slot=$(basename "$slot_path")
    if [ -f "$sysroot/bus/usb/devices/$slot/idVendor" ]; then
        slot_type=usb
        break
    elif [ -f "$sysroot/bus/pci/devices/$slot/vendor" ]; then
        slot_type=pcie
        break
    fi
    slot_path=$(dirname "$slot_path")
done
[ -n "$slot_type" ] || exit

logger -t modem_hotplug "net slot: ${slot} action: ${ACTION} slot_type: ${slot_type}"
case "${ACTION}" in
    add|\
    bind)
        (/usr/share/qmodem/modem_scan.sh add "${slot}" "${slot_type}" "${hotplug_add_delay}" >/dev/null 2>&1) &
        ;;
esac
